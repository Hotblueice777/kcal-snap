
# Azure Speech Service
AZURE_SPEECH_KEY=your_azure_speech_key_here
AZURE_SPEECH_REGION=your_azure_region_here
# e.g., canadacentral / eastus / eastus2

# Azure OpenAI Service
AZURE_OPENAI_KEY=your_azure_openai_key_here
AZURE_OPENAI_ENDPOINT=https://your-openai-resource-name.openai.azure.com/
DEPLOYMENT_NAME=gpt-4o-mini


# Azure QnA (Language Studio)
AZURE_QNA_ENDPOINT=https://your-qna-resource-name.cognitiveservices.azure.com/
AZURE_QNA_PROJECT=KcalSnapQnA
AZURE_QNA_DEPLOYMENT=production
AZURE_QNA_KEY=your_qna_key_here

# App Settings
PORT=8000
ENV=production
